# =============================================
# Eviworx — Environment Configuration
# =============================================
# Copy to .env and fill in all values!
# docker compose refuses to start while a required value is empty.
# cp .env.example .env
#
# Generate secrets:
#   Passwords:       openssl rand -hex 32
#   Hex keys:        openssl rand -hex 32
#   VAPID keys:      npx web-push generate-vapid-keys

# --- Domain / Frontend URL ---
# Comma-separated if multiple domains (e.g. internal + external)
FRONTEND_URL=https://helpdesk.example.com

# --- Database ---
POSTGRES_USER=helpdesk_user
POSTGRES_PASSWORD=              # openssl rand -hex 32
POSTGRES_DB=helpdesk_db
JOBWORKER_DB_PASSWORD=          # openssl rand -hex 32
READONLY_DB_PASSWORD=           # openssl rand -hex 32

# --- Redis ---
REDIS_PASSWORD=                 # openssl rand -hex 32

# --- JWT (Session Token) ---
JWT_SECRET=                     # openssl rand -hex 48

# --- Share Token (for time-limited public sharing URLs) ---
# REQUIRED — Backend boots with fatal error if missing.
SHARE_SECRET=                   # openssl rand -hex 32
# SHARE_SECRET_OLD=             # Optional, for zero-downtime rotation

# --- Internal API Key (service-to-service) ---
INTERNAL_API_KEY=               # openssl rand -hex 32

# --- Encryption Keys ---
LICENSE_ENCRYPTION_KEY=         # openssl rand -hex 32
TWO_FACTOR_ENCRYPTION_KEY=     # openssl rand -hex 32

# --- Web Push (VAPID) ---
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Admin ---
# Password of the first admin account, used only on the very first start.
# Keep the line afterwards: docker compose refuses to start without it.
ADMIN_INITIAL_PASSWORD=         # Secure password, min. 12 characters
SEED_DATABASE=true              # Set to false after first start

# --- Optional: Cloudflare Turnstile CAPTCHA ---
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: Email Branding ---
# EMAIL_ACCENT_COLOR=#3b8f93
# EMAIL_APP_NAME=Eviworx
# EMAIL_APP_URL=https://helpdesk.example.com
# EMAIL_FOOTER_TEXT=Powered by Eviworx
# EMAIL_LAYOUT_ENABLED=true

# --- Product License ---
# No entry needed: the license (or a trial from https://lic.eviworx.com/en/trial)
# is activated in the web UI after the first login:
# Admin Center > System > Product License.

# --- Optional: Report Generator ---
# COMPANY_NAME=Company Inc.
# CSV_DELIMITER=;

# --- Optional: Session Timeouts ---
# SESSION_MAX_HOURS=12
# ACCESS_TOKEN_EXPIRY_MINUTES=60
# REFRESH_TOKEN_EXPIRY_MINUTES=100
# Minutes of inactivity before an idle session is ended (server-owned).
# IDLE_TIMEOUT_MINUTES=30

# --- Optional: Auth rate limits (NAT-safe defaults) ---
# Auth limiters count per 15-minute window; GLOBAL_RATE_LIMIT_MAX and
# CRITICAL_OPS_RATE_LIMIT_MAX count per minute. All take effect on backend
# restart (no rebuild needed). Raise REFRESH_FAIL_PER_IP_MAX /
# LOGOUT_PER_IP_MAX temporarily for a rollout window that forces all
# users to re-login.
# GLOBAL_RATE_LIMIT_MAX=2000
# AUTH_FAIL_PER_PAIR_MAX=5
# AUTH_FAIL_PER_IP_MAX=30
# REFRESH_FAIL_PER_IP_MAX=60
# LOGOUT_PER_IP_MAX=120
# TWOFA_FAIL_PER_IP_MAX=20
# FORGOT_PW_PER_IP_MAX=20
# RESET_PW_PER_IP_MAX=20
# OAUTH_CB_PER_IP_MAX=30
# INVITE_LOOKUP_PER_IP_MAX=30
# PASSWORD_CHANGE_MAX=10
# CRITICAL_OPS_RATE_LIMIT_MAX=60

# --- Optional: Trusted Proxies (for correct client IP logging) ---
# Comma-separated CIDR ranges of upstream proxies/load balancers.
# Must also be added to traefik/traefik.yml forwardedHeaders.trustedIPs.
# TRUSTED_PROXIES=198.51.100.0/24,203.0.113.0/24

# --- Optional: SSRF webhook allowlist ---
# Allow webhooks to specific internal targets. Comma-separated list of
# IPv4, IPv4-CIDR, IPv6, IPv6-prefix or hostname (exact match). Applies to
# both save-time validation and runtime (job-worker + workflow-engine) — one
# gate in the backend. Private ranges (10/8, 172.16/12, 192.168/16, CGNAT
# 100.64/10, IPv6 ULA fc00::/7) need an entry here; loopback, unspecified,
# link-local, multicast and cloud metadata are NEVER allowable (also not in
# IPv6 notation such as ::ffff:127.0.0.1).
# SSRF_ALLOWLIST=10.20.1.1/32,172.22.0.0/16,erp.internal.company.com
# Override allowed destination ports (default: 80,443,8080,8443).
# SSRF_ALLOWED_PORTS=80,443,8080,8443,9443

# --- Optional: Outbound proxy (corporate proxy for license server, Entra ID, ---
# --- Teams/Webex, Web Push, webhooks, antivirus updates) — see README ---
# Without these values every outbound call goes direct.
# HTTPS_PROXY=http://proxy.company.example:3128
# HTTP_PROXY=http://proxy.company.example:3128
# Additional targets that must NOT use the proxy (host names, .domain suffixes;
# no CIDR ranges). Appended to the built-in list of internal services.
# Internal webhook targets from SSRF_ALLOWLIST belong here by name as well.
# NO_PROXY=erp.internal.company.com,.intranet.company.com
# Corporate CA for TLS inspection: put the PEM into ./certs/proxy/
# NODE_EXTRA_CA_CERTS=/etc/eviworx/proxy-ca/corporate-ca.pem
# Antivirus signature updates (freshclam): unset = use HTTPS_PROXY,
# empty = direct, own value = own proxy.
# CLAMAV_HTTPS_PROXY=
# CLAMAV_NO_PROXY=
# Container without external DNS (only the proxy resolves names): allow webhook
# targets the container cannot resolve. The proxy ACL is then the boundary —
# block private networks there for this host.
# SSRF_PROXY_RESOLVES_DNS=true

# --- Optional: Upload Limits ---
# MAX_FILE_SIZE=104857600        # 100 MB
# FILE_UPLOAD_RATE_LIMIT=200     # Uploads per hour/IP
